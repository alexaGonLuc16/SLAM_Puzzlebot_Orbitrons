Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false # Puedes activarlo para presumir tus colisiones
      Links:
        All Links Enabled: true
      Value: true

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true  # Aquí sí conviene ver los nombres para identificar cada link
      Marker Scale: 0.5 # Escala pequeña para que no tapen al robot
      Value: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link # IMPORTANTE: En descripción el centro es el robot
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 2.0
      Pitch: 0.3
      Yaw: 0.7
    Saved: ~

Window Geometry:
  Height: 800
  Width: 1200