<launch>
    <arg name="slam_params_file" default="$(find-pkg-share puzzlebot_real_robot)/config/slam_toolbox_real.yaml" />
    <arg name="rviz_config_path" default="$(find-pkg-share puzzlebot_navigation2)/rviz/slam.rviz" />

    <node pkg="slam_toolbox"
          exec="async_slam_toolbox_node"
          name="slam_toolbox"
          output="screen">
        <param name="use_sim_time" value="false" />
        <param from="$(var slam_params_file)" />
    </node>

    <node pkg="rviz2"
          exec="rviz2"
          name="rviz2"
          output="screen"
          args="-d $(var rviz_config_path)">
        <param name="use_sim_time" value="false" />
    </node>

    <node pkg="teleop_twist_keyboard"
          exec="teleop_twist_keyboard"
          name="teleop_keyboard"
          output="screen"
          launch-prefix="xterm -e" />
</launch>