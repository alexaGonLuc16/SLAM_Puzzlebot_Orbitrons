<launch>
    <let name="nav2_bringup_launch_path" value="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py" />

    <arg name="map_path" default="$(find-pkg-share puzzlebot_real_robot)/maps/map_maze_real.yaml" />
    <arg name="nav2_params_file" default="$(find-pkg-share puzzlebot_real_robot)/config/nav2_params_real.yaml" />
    <arg name="rviz_config_path" default="$(find-pkg-share puzzlebot_navigation2)/rviz/nav2.rviz" />
    <arg name="launch_rviz" default="true" />

    <include file="$(find-pkg-share puzzlebot_real_robot)/launch/real_robot_core.launch.xml" />

    <include file="$(var nav2_bringup_launch_path)">
        <arg name="map" value="$(var map_path)" />
        <arg name="use_sim_time" value="false" />
        <arg name="params_file" value="$(var nav2_params_file)" />
    </include>

    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
          args="-d $(var rviz_config_path)" if="$(var launch_rviz)">
        <param name="use_sim_time" value="false" />
    </node>
</launch>