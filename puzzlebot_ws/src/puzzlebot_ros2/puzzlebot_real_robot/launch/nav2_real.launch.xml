<?xml version="1.0"?>
<launch>
    <let name="use_sim_time" value="false"/>
    <let name="nav2_core_file" value="$(find-pkg-share puzzlebot_navigation2)/launch/nav2_core.launch.xml"/>
    <let name="nav2_params_file" value="$(find-pkg-share puzzlebot_real_robot)/config/nav2_params_real.yaml"/>
    <let name="map_path" value="$(find-pkg-share puzzlebot_real_robot)/maps/map_maze_real.yaml"/>
    <let name="rviz_config_path" value="$(find-pkg-share puzzlebot_navigation2)/rviz/nav2.rviz"/>

    <include file="$(var nav2_core_file)">
        <arg name="map_path" value="$(var map_path)"/>
        <arg name="nav2_params_file" value="$(var nav2_params_file)"/>
        <arg name="rviz_config_path" value="$(var rviz_config_path)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
</launch>